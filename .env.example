# Copy this file to backend/.env and fill in real values for local dev.
# In staging/production, set these as real environment variables on the
# host/container instead of shipping a .env file.

# --- Server ---
APP_PORT=8080

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busdb
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# --- Auth ---
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
