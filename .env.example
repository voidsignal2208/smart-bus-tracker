# Copy to .env in the project root and fill in real values.
# docker-compose reads this file automatically. Never commit the real .env.

APP_PORT=8080
FRONTEND_PORT=80

# --- Backend / Postgres ---
# Point at your existing hosted DB, or at the local "postgres" compose
# service (DB_HOST=postgres) when using --profile local-db.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busdb
DB_USER=busapp
DB_PASSWORD=replace_with_a_strong_database_password
DB_SSLMODE=require

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_unique_long_random_secret

# Server-side Google Maps key used by the backend (if applicable)
GOOGLE_MAPS_SERVER_KEY=

# --- Redis ---
# Caches the latest known position per bus. "redis" is the docker-compose
# service name below; point elsewhere (e.g. a managed Redis) if you're not
# using the bundled container. Leave REDIS_PASSWORD empty for the bundled
# container (no auth configured).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Frontend (baked into the JS bundle at build time) ---
# Leave empty to call the API via relative paths (nginx proxies /api and /ws
# to the backend container - see busyatri/nginx.conf).
VITE_API_BASE_URL=
VITE_GOOGLE_MAPS_API_KEY=replace_with_your_maps_browser_key
