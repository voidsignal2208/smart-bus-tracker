# Leave empty for local dev (Vite's proxy in vite.config.js handles it).
# Set to a full origin (e.g. https://api.yourapp.com) only for a
# production build that talks to a backend on a different origin - and
# make sure that backend sends CORS headers for your frontend's origin
# if you do.
VITE_API_BASE_URL=

# Google Maps JS API key - restrict this key (in Google Cloud Console) to
# your site's HTTP referrers, since it is bundled into the frontend and
# visible to anyone. Use a DIFFERENT key than the backend's
# GOOGLE_MAPS_SERVER_KEY, which should stay server-side only.
VITE_GOOGLE_MAPS_API_KEY=CHANGE_ME_google_maps_browser_key
